# Copy to .env (never commit .env). Without a key AETHER still works using its rule engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CACHE_TTL_SECONDS=600
RATE_LIMIT_PER_MINUTE=30
REQUEST_TIMEOUT_SECONDS=8
GEMINI_CALLS_PER_MINUTE=60
# Number of reverse proxies in front of the app (1 on Cloud Run). 0 ignores X-Forwarded-For.
TRUSTED_PROXY_HOPS=0
